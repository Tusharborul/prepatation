        "lint": "echo \"No linting configured\"",
        "test": "npm run test:transcription && npm run test:reconnect && npm run test:groq",
        "test:groq": "electron scripts/test-groq-stream.js",
        "test:transcription": "electron scripts/test-transcription.js",
        "test:reconnect": "electron scripts/test-reconnect.js",
        "test:live": "electron scripts/test-gemini-live.js",
        "check:providers": "node scripts/check-providers.js"
    },
    "keywords": [
        "interview",
        "interview preparation",
        "ai assistant",
        "electron",
        "speech to text"
